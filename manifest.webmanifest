{
  "name": "QR Studio",
  "short_name": "QR Studio",
  "description": "Create, style, verify and export QR codes locally in your browser.",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#5b21b6",
  "categories": ["utilities", "productivity", "design"],
  "share_target": {
    "action": "./?share-target=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "assets/qr-studio-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
